# Runtime configuration for the sync service (WHOOSH2GARMIN_* env vars).
# Copy to ~/.config/whooshtogarmin/whooshtogarmin.env and adjust.

# Data volume inside the container (matches the Quadlet Volume= mount).
WHOOSH2GARMIN_DATA_DIR=/data

# Timezone used to fix the activity's local timestamp.
WHOOSH2GARMIN_TZ_NAME=Europe/Vienna

# How often to check myWhoosh for new activities (seconds) + jitter fraction.
WHOOSH2GARMIN_POLL_INTERVAL_SECONDS=900
WHOOSH2GARMIN_JITTER_FRACTION=0.1

# Quiet hours (local): polling slows by the multiplier between start and end.
# Set start == end to disable.
WHOOSH2GARMIN_QUIET_HOURS_START=2
WHOOSH2GARMIN_QUIET_HOURS_END=6
WHOOSH2GARMIN_QUIET_INTERVAL_MULTIPLIER=4.0

# Garmin China domain (true/false).
WHOOSH2GARMIN_GARMIN_IS_CN=false

WHOOSH2GARMIN_LOG_LEVEL=INFO
